<Project>
  <!-- global configuration -->
  <PropertyGroup>
    <Copyright>Copyright (c) tuke productions</Copyright>
    <Company>tuke productions</Company>
    <Authors>Tony Meissner</Authors>
    <Owners>Tony Meissner</Owners>
    <Product>SimTuning</Product>
    <Description>Ein Tool, um Simson-Begeisterte etwas unter die Arme zu greifen und zu helfen.</Description>
    <PackageTags>c#, maui, windows, android, iOS, mac</PackageTags>
    <NeutralLanguage>de-DE</NeutralLanguage>
    <RepositoryUrl>https://github.com/tuke307/SimTuning</RepositoryUrl>
    <PackageReleaseNotes>https://github.com/tuke307/SimTuning/releases</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--  build configuration -->
  <PropertyGroup>
  <TargetFrameworks>net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net11.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
    <UseMaui>true</UseMaui>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);1591;1701;1702;1705;VSX1000;NU1603</NoWarn>
  </PropertyGroup>

  <!-- version configuration -->
  <PropertyGroup>
    <Version>2.0.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- release configuration -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
  </PropertyGroup>

  <!-- debug configuration -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)/Code Rules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>


  <!-- Nuget configuration -->
  <ItemGroup>
    <!-- Nugets -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-preview.6.26360.8" />
		<!-- Microsoft.Maui.Controls.Compatibility removed (Phase 3): unused in this codebase and no longer shipped in MAUI 11. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="UnitsNet" Version="5.75.1" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.0" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
    <PackageReference Include="Sharpnado.Maui.TaskLoaderView" Version="2.6.3" />
    <PackageReference Include="Sharpnado.Tabs.Maui" Version="4.0.1" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Maui" Version="2.0.5" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <!-- Newtonsoft.Json removed (Phase 14 A08): the sole consumer (DynoDataViewModel export/import)
         migrated to System.Text.Json. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <!-- CommunityToolkit.WinUI.Notifications moved to SimTuning.Maui.App.csproj (Phase 3): Windows-only, made conditional. -->

    <!-- Analyzers -->
    <PackageReference Include="AsyncFixer" Version="2.1.0" PrivateAssets="All" />

    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
	</ItemGroup>
</Project>
