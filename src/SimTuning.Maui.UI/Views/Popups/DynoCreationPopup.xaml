<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup
	x:TypeArguments="models:VehiclesModel"
	xmlns="http://schemas.microsoft.com/dotnet/maui/global"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="SimTuning.Maui.UI.Views.Popups.DynoCreationPopup"
	xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
	xmlns:models="clr-namespace:SimTuning.Data.Models;assembly=SimTuning.Data"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	x:DataType="VehiclesViewModel"
	WidthRequest="300"
	HeightRequest="150"
	BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label
			Grid.Row="0"
			Margin="5"
			HorizontalOptions="CenterAndExpand">
            Für welches Fahrzeug willst du eine Leistungsmessung durchführen?
        </Label>

        <Picker
			Grid.Row="1"
			ItemsSource="{Binding Vehicles}"
			SelectedItem="{Binding Vehicle}"
			ItemDisplayBinding="{Binding Name}"
			HorizontalOptions="CenterAndExpand"
			Margin="5">
        </Picker>

        <ImageButton
			Grid.Row="2"
			Clicked="Button_Clicked"
			Margin="5"
			Source="{StaticResource IconChevronRightMedium}" />
    </Grid>
</mct:Popup>
