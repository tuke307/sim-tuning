                        </HorizontalStackLayout>
                    </Expander>-->
            </StackLayout>
        </Border>

        <Button
			Margin="5"
			Grid.Row="2"
			ImageSource="{StaticResource IconChevronRightMedium}"
			Clicked="Button_Clicked">
        </Button>
    </Grid>
</ContentView>
