{
  "name": "@sim-tuning/api",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Tony Meissner",
  "type": "module",
  "exports": {
    "./services/email.service": {
      "types": "./src/modules/email/email.service.ts",
      "default": "./dist/src/modules/email/email.service.js"
    },
    "./services/bullmq.service": {
      "types": "./src/modules/bullmq/bullmq.service.ts",
      "default": "./dist/src/modules/bullmq/bullmq.service.js"
    },
    "./services/prisma.service": {
      "types": "./src/modules/database/prisma.service.ts",
      "default": "./dist/src/modules/database/prisma.service.js"
    }
  },
  "scripts": {
    "build": "nestgo build",
    "clean": "rm -rf dist",
    "dev": "nestgo start --watch --env-file .env.local",
    "lint": "tsc --noEmit && eslint . --max-warnings 0",
    "test": "node --import tsx --test src/**/*.spec.ts",
    "openapi:export": "tsx src/openapi-export.ts",
    "start:debug": "nestgo start --watch --debug",
    "start": "dotenv -e .env.local -- node dist/src/main.js",
    "start:prod": "node dist/src/main.js"
  },
  "dependencies": {
    "@sim-tuning/common": "*",
    "@sim-tuning/database": "*",
    "@sim-tuning/logger": "*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "juice": "^12.2.0",
    "mjml": "^5.4.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bull-board/express": "^9.10.4",
    "@bull-board/ui": "^9.10.4",
    "@sim-tuning/eslint-config": "*",
    "@sim-tuning/typescript-config": "*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mjml": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "nestgo": "^0.0.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.3",
    "winston": "^3.19.0"
  }
}
