# General
API_PORT=3001
NODE_ENV=development

# Auth
BCRYPT_SALT_ROUNDS=10
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY_MS=900000
REFRESH_TOKEN_EXPIRY_MS=604800000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5438/sim_tuning

# Frontend
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=

# Redis
REDIS_URL=redis://localhost:6383

# SMTP / Email
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=false
EMAIL_FROM=noreply@simtuning.app
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=5000

# Web analytics (self-hosted Umami, pageviews only; forwarding only when NODE_ENV=production)
UMAMI_URL=https://umami.tony-luke.de
UMAMI_WEBSITE_ID=
# Comma-separated hostnames whose pageviews are forwarded
UMAMI_ALLOWED_HOSTNAMES=simtuning.tony-luke.de
